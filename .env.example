# GEMINI_API_KEY: Optional, if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase (требуется только публичный Anon Key, SERVICE_ROLE_KEY не нужен!)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Для статической сборки (например, GitHub Pages) задайте переменные с префиксом VITE_
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
